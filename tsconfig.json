{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"]
    },
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["@remix-run/node", "vite/client"]
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "vite.config.js"]
}
